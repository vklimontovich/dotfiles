# ============================================================================
# LAZY-LOADING INFRASTRUCTURE
# ============================================================================

# Generic lazy-load function
# Usage: _lazy_load <marker_var> <init_function> <command> [<command2> ...]
_lazy_load() {
  local marker_var="$1"
  local init_func="$2"
  shift 2

  # Check if already loaded
  if [[ "${(P)marker_var}" == "1" ]]; then
    return 0
  fi

  # Unset all placeholder functions
  for cmd in "$@"; do
    unset -f "$cmd" 2>/dev/null
  done

  # Run initialization
  eval "$init_func"

  # Mark as loaded
  eval "$marker_var=1"
}

