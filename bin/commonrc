# commonrc — shell config sourced by both bash and zsh.
# Sets PATH, aliases, completions, prompt-time hooks, venv auto-activation,
# and lazy-loads tooling. Loaded from .zshrc / .bashrc.

export EDITOR=nano
export REACT_EDITOR=idea

# Disable virtualenv from modifying the prompt (we handle it in our custom prompt)
export VIRTUAL_ENV_DISABLE_PROMPT=1

add_to_path() {
    local new_path="$PATH"
    local dir
    for dir in "$@"; do
        if [ -d "$dir" ] && [[ ":$new_path:" != *":$dir:"* ]]; then
            new_path="$dir:$new_path"
        fi
    done
    export PATH="$new_path"
}

if [ -f `dirname $0`/commonrc.secrets ]; then
    source `dirname $0`/commonrc.secrets
fi

if [ -x /usr/libexec/java_home ]; then
    JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null)
    if [ -d "$JAVA_HOME" ]; then
        export JAVA_HOME
    fi
fi

if [ -f $HOME/Library/Android/sdk ]; then
	export ANDROID_SDK_ROOT=$HOME/Library/Android/sdk
fi

export CONFLUENT_HOME=~/confluent-platform

add_to_path \
    ~/bin \
    ~/bin/local \
    /sbin \
    /usr/sbin \
    /usr/local/sbin \
    /opt/homebrew/bin \
    /opt/homebrew/sbin \
    /usr/local/go/bin \
    ~/go/bin \
    ~/.yarn/bin \
    ~/.config/yarn/global/node_modules/.bin \
    ~/.pyenv/shims \
    ~/.bun \
    ~/.cargo/bin \
    "$CONFLUENT_HOME/bin" \
    ~/.local/bin

alias pnpm='ding pnpm'
alias bun='ding bun'
alias ll='ls -l -h'

alias k='kubectl'
alias dotfiles=~/dotfiles/dotfiles

source `dirname $0`/z

if [ -n "$ZSH_VERSION" ]; then
  precmd() { print -Pn "\e]0;%n@%m: %~\a"; }
fi


# ============================================================================
# LAZY-LOADING INFRASTRUCTURE
# ============================================================================

# Generic lazy-load function
# Usage: _lazy_load <marker_var> <init_function> <command> [<command2> ...]
_lazy_load() {
  local marker_var="$1"
  local init_func="$2"
  shift 2

  # Check if already loaded
  if [[ "${(P)marker_var}" == "1" ]]; then
    return 0
  fi

  # Unset all placeholder functions
  for cmd in "$@"; do
    unset -f "$cmd" 2>/dev/null
  done

  # Run initialization
  eval "$init_func"

  # Mark as loaded
  eval "$marker_var=1"
}

