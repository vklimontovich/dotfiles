# _claude_dep_banner — warn that a profile-picker dependency is missing.
_claude_dep_banner() {
  local dep="$1" hint="$2"
  echo "⚠️  Claude profiles need '$dep', which isn't installed — running the default profile." >&2
  echo "    Install it: $hint" >&2
}

# Resolve a claude profile name to its config dir. "default" maps to ~/.claude;
# anything else is looked up in ~/.claude-profiles.yaml. Prints nothing and
# returns 1 if the name is unknown.
_claude_profile_dir() {
  local config="$HOME/.claude-profiles.yaml" dir
  if [ "$1" = "default" ]; then
    echo "$HOME/.claude"
    return 0
  fi
  dir=$(yq -r ".[] | select(.name == \"$1\") | .dir" "$config" 2>/dev/null)
  [ -z "$dir" ] || [ "$dir" = "null" ] && return 1
  dir="${dir/#\~/$HOME}"
  echo "${dir%/}"
}

# Print a tab-separated table of claude profiles (header + one row per profile),
# with "default" always first. Plan, billing, and account are read straight from
# each profile's <dir>/.claude.json oauthAccount — no need to launch claude.
# Billing is "metered" when the account bills per token, else "flat".
_claude_profiles_table() {
  local config="$HOME/.claude-profiles.yaml"
  local -a names
  local n d disp j email plan billing
  names=($(yq -r '.[].name' "$config" 2>/dev/null))
  printf 'PROFILE\tPLAN\tBILLING\tACCOUNT\tDIR\n'
  for n in default "${names[@]}"; do
    [ "$n" = "default" ] && [ -n "$_seen_default" ] && continue
    [ "$n" = "default" ] && _seen_default=1
    d=$(_claude_profile_dir "$n") || continue
    j="$d/.claude.json"; [ "$n" = "default" ] && j="$HOME/.claude.json"
    disp="$d"; case "$disp" in "$HOME"/*) disp="~${disp#$HOME}";; esac
    email="-"; plan="-"; billing="-"
    if [ -f "$j" ]; then
      email=$(jq -r '.oauthAccount.emailAddress // "-"' "$j" 2>/dev/null)
      plan=$(jq -r '.oauthAccount.organizationRateLimitTier // "-"
                    | sub("^default_";"") | sub("^claude_";"") | sub("^raven_";"")
                    | gsub("_";" ")' "$j" 2>/dev/null)
      billing=$(jq -r '.oauthAccount
                    | if ((.seatTier // "")|test("usage")) or ((.billingType // "")|test("usage"))
                      then "metered" else "flat" end' "$j" 2>/dev/null)
      [ -z "$plan" ] && plan="-"
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$plan" "$billing" "$email" "$disp"
  done
  unset _seen_default
}

# claude-profiles — print the profile table without launching anything.
claude-profiles() {
  if ! command -v yq >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    echo "claude-profiles needs yq and jq — run: brew install yq jq" >&2
    return 1
  fi
  [ -f "$HOME/.claude-profiles.yaml" ] || { echo "No ~/.claude-profiles.yaml" >&2; return 1; }
  _claude_profiles_table | column -t -s $'\t'
}

# claude — wrapper that picks a config profile before launching the CLI.
# Profiles live in ~/.claude-profiles.yaml as a list of { name, dir }. The
# "default" profile always maps to ~/.claude and is always listed first. Set
# CLAUDE_PROFILE to skip the picker (e.g. CLAUDE_PROFILE=pp claude). Needs
# yq + fzf + jq; if a dep is missing it prints a banner and runs the default.
# The picker shows each profile's plan, billing mode, account, and config dir.
claude() {
  local config="$HOME/.claude-profiles.yaml"
  local -a names
  local profile dir

  # No profiles configured: run claude untouched, no noise.
  if [ ! -f "$config" ]; then
    command claude "$@"
    return
  fi

  # yq reads the profiles; without it the picker can't work.
  if ! command -v yq >/dev/null 2>&1; then
    _claude_dep_banner yq "brew install yq"
    command claude "$@"
    return
  fi
  if ! command -v jq >/dev/null 2>&1; then
    _claude_dep_banner jq "brew install jq"
    command claude "$@"
    return
  fi

  # Count distinct profiles (default is always available, even if not listed).
  names=($(yq -r '.[].name' "$config" 2>/dev/null))
  if [[ " ${names[*]} " != *" default "* ]]; then
    names=(default "${names[@]}")
  fi
  if [ ${#names[@]} -le 1 ]; then
    command claude "$@"
    return
  fi

  if [ -n "$CLAUDE_PROFILE" ]; then
    profile="$CLAUDE_PROFILE"
  elif ! command -v fzf >/dev/null 2>&1; then
    _claude_dep_banner fzf "brew install fzf"
    command claude "$@"
    return
  else
    profile=$(_claude_profiles_table | column -t -s $'\t' |
      fzf --ansi --no-sort --no-mouse --header-lines=1 \
          --prompt="Select Claude profile > " --height=~30 --reverse |
      awk '{print $1}')
    [ -z "$profile" ] && return 1
  fi

  # The default profile is native: leave CLAUDE_CONFIG_DIR unset so claude
  # uses ~/.claude.json (setting it to ~/.claude would read ~/.claude/.claude.json
  # instead, a different and empty config).
  if [ "$profile" = "default" ]; then
    echo "🤖 Claude profile: default" >&2
    command claude "$@"
    return
  fi

  dir=$(_claude_profile_dir "$profile")
  if [ -z "$dir" ]; then
    echo "⚠️  Unknown Claude profile: $profile" >&2
    return 1
  fi

  echo "🤖 Claude profile: $profile ($dir)" >&2
  CLAUDE_CONFIG_DIR="$dir" command claude "$@"
}
