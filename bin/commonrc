    ~/go/bin \
    ~/.yarn/bin \
    ~/.config/yarn/global/node_modules/.bin \
    ~/.pyenv/shims \
    ~/.bun \
    ~/.cargo/bin \
    "$CONFLUENT_HOME/bin" \
    ~/.local/bin

