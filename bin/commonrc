# kubectl, aws, and gcloud completions now loaded via Homebrew site-functions in fpath


if [ -n "$ZSH_VERSION" ]; then
  bindkey "\e\e[D" beginning-of-line
  bindkey "\e\e[C" end-of-line
fi

# Enable direnv if installed
if command -v direnv >/dev/null 2>&1; then
  if [ -n "$ZSH_VERSION" ]; then
    eval "$(direnv hook zsh)"
  elif [ -n "$BASH_VERSION" ]; then
    eval "$(direnv hook bash)"
  fi
fi

# Auto-activate/deactivate virtualenv on directory change (ZSH only)
if [ -n "$ZSH_VERSION" ]; then
  autoload -U add-zsh-hook

  _venv_auto_activate() {
    [ "$DEBUG" = "1" ] && echo "[DEBUG] chpwd triggered in: $PWD"
    [ "$DEBUG" = "1" ] && echo "[DEBUG] Current VIRTUAL_ENV: ${VIRTUAL_ENV:-none}"

    if [ -f ".venv/bin/activate" ]; then
      # Only activate if not already in this venv
      if [ "$VIRTUAL_ENV" != "$PWD/.venv" ]; then
        [ "$DEBUG" = "1" ] && echo "[DEBUG] Activating venv: $PWD/.venv"
        source .venv/bin/activate
        echo "🐍 activated .venv/bin/activate →  $VIRTUAL_ENV_PROMPT, $(which python)"
      else
        [ "$DEBUG" = "1" ] && echo "[DEBUG] Already in this venv"
      fi
    else
      [ "$DEBUG" = "1" ] && echo "[DEBUG] No .venv/bin/activate found"
      # Deactivate if we were in a venv and moved out of its directory
      if [ -n "$VIRTUAL_ENV" ]; then
        local venv_dir="${VIRTUAL_ENV%/*}"
        [ "$DEBUG" = "1" ] && echo "[DEBUG] venv_dir: $venv_dir"
        if [[ "$PWD" != "$venv_dir"* ]]; then
          [ "$DEBUG" = "1" ] && echo "[DEBUG] Deactivating venv"
        	echo " ❌ 🐍 Deactivating $VIRTUAL_ENV_PROMPT"
          	deactivate 2>/dev/null
        else
          [ "$DEBUG" = "1" ] && echo "[DEBUG] Still in venv directory tree"
        fi
      fi
    fi
  }

  add-zsh-hook chpwd _venv_auto_activate
  # Run once on shell start
   [ "$DEBUG" = "1" ] && echo "initially activating venv on : $PWD"
  _venv_auto_activate
fi

# Restore AWS profile from previous session
if [ -f "$HOME/.aws-profile" ]; then
  export AWS_PROFILE="$(cat "$HOME/.aws-profile")"
fi

# Source selector functions
source ~/bin/selectors
