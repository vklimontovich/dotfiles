source ~/bin/selectors

# claude — wrapper that picks a config profile before launching the CLI.
# Profiles live in ~/.claude-profiles.yaml as a list of { name, dir }. The
# "default" profile always maps to ~/.claude. Set CLAUDE_PROFILE to skip the
# picker (e.g. CLAUDE_PROFILE=pp claude). Needs yq + fzf; without them, or with
# a single profile, it just runs claude untouched.
claude() {
  local config="$HOME/.claude-profiles.yaml"
  local -a names
  local profile dir

  if [ ! -f "$config" ] || ! command -v yq >/dev/null 2>&1; then
    command claude "$@"
    return
  fi

  # Collect profile names, making sure "default" is always present.
  names=($(yq -r '.[].name' "$config" 2>/dev/null))
  if [[ " ${names[*]} " != *" default "* ]]; then
    names=(default "${names[@]}")
  fi

  # Nothing to choose between: run claude as-is.
  if [ ${#names[@]} -le 1 ]; then
    command claude "$@"
    return
  fi

  if [ -n "$CLAUDE_PROFILE" ]; then
    profile="$CLAUDE_PROFILE"
  elif ! command -v fzf >/dev/null 2>&1; then
    command claude "$@"
    return
  else
    profile=$(for p in "${names[@]}"; do
      if [ "$p" = "default" ]; then
        echo "• $p"
      else
        echo "  $p"
      fi
    done | fzf --ansi --no-sort --no-mouse --prompt="Select Claude profile > " --height=~30 --reverse | sed 's/^• //;s/^  //')
    [ -z "$profile" ] && return 1
  fi

  # The default profile is native: leave CLAUDE_CONFIG_DIR unset so claude
  # uses ~/.claude.json (setting it to ~/.claude would read ~/.claude/.claude.json
  # instead, a different and empty config).
  if [ "$profile" = "default" ]; then
    echo "🤖 Claude profile: default" >&2
    command claude "$@"
    return
  fi

  # Resolve the config dir for the chosen profile.
  dir=$(yq -r ".[] | select(.name == \"$profile\") | .dir" "$config" 2>/dev/null)
  if [ -z "$dir" ] || [ "$dir" = "null" ]; then
    echo "⚠️  Unknown Claude profile: $profile" >&2
    return 1
  fi

  # Expand a leading ~ and strip the trailing slash.
  dir="${dir/#\~/$HOME}"
  dir="${dir%/}"

  echo "🤖 Claude profile: $profile ($dir)" >&2
  CLAUDE_CONFIG_DIR="$dir" command claude "$@"
}
