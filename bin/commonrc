# commonrc — shell config sourced by both bash and zsh.
# Sets PATH, aliases, completions, prompt-time hooks, venv auto-activation,
# and lazy-loads tooling. Loaded from .zshrc / .bashrc.

export EDITOR=nano
export REACT_EDITOR=idea

# Disable virtualenv from modifying the prompt (we handle it in our custom prompt)
export VIRTUAL_ENV_DISABLE_PROMPT=1

add_to_path() {
    local new_path="$PATH"
    local dir
    for dir in "$@"; do
        if [ -d "$dir" ] && [[ ":$new_path:" != *":$dir:"* ]]; then
            new_path="$dir:$new_path"
        fi
    done
    export PATH="$new_path"
}

if [ -f ~/bin/commonrc.secrets ]; then
    source ~/bin/commonrc.secrets
fi

if [ -x /usr/libexec/java_home ]; then
    JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null)
    if [ -d "$JAVA_HOME" ]; then
        export JAVA_HOME
    fi
fi

if [ -f $HOME/Library/Android/sdk ]; then
	export ANDROID_SDK_ROOT=$HOME/Library/Android/sdk
fi

