#!/usr/bin/env bash
# Thin wrapper so the tool is `mcp-view`, not `mcp-view.py`.
# The script next to this one carries a uv shebang and declares its own
# dependencies inline (PEP 723), so there is nothing to install.
set -euo pipefail

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

if ! command -v uv >/dev/null 2>&1; then
  echo "mcp-view: needs uv — https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 127
fi

exec "$here/mcp-view.py" "$@"
