#!/usr/bin/env bash
# ovn — openfortivpn wrapper
#
#   ovn status       show whether the tunnel is up
#   ovn connect      ensure it's connected (no-op if already up)
#   ovn disconnect   ensure it's disconnected (no-op if already down)
#
# On first `ovn connect`, if /etc/openfortivpn/config doesn't exist yet,
# prompts for host/port/username and a 1Password secret reference for the
# password (never stored on disk in plaintext — pulled from `op` at
# connect time). The 1Password reference is saved to
# /etc/openfortivpn/.1p.
set -euo pipefail

CONFIG_DIR="/etc/openfortivpn"
CONFIG_FILE="$CONFIG_DIR/config"
OP_REF_FILE="$CONFIG_DIR/.1p"
LOG_FILE="${TMPDIR:-/tmp}/openfortivpn.log"
RESOLVER_DIR="/etc/resolver"
RESOLVER_MANIFEST="$CONFIG_DIR/.resolvers"

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
  bold="$(tput bold)"
  dim="$(tput dim)"
  red="$(tput setaf 1)"
  green="$(tput setaf 2)"
  yellow="$(tput setaf 3)"
  reset="$(tput sgr0)"
else
  bold=""; dim=""; red=""; green=""; yellow=""; reset=""
fi

note() { printf "%b\n" "${yellow}⚠ $*${reset}"; }
die()  { printf "%b\n" "${red}✖ $*${reset}" >&2; exit 1; }

usage() {
  cat <<EOF
${bold}ovn${reset} - openfortivpn wrapper

Usage:
  ovn status
  ovn connect
  ovn disconnect
EOF
}

require_op() {
  command -v op >/dev/null 2>&1 || die "1Password CLI ('op') not found. Install with: brew install 1password-cli"
}

require_openfortivpn() {
  command -v openfortivpn >/dev/null 2>&1 || die "openfortivpn not found. Install with: brew install openfortivpn"
}

is_connected() {
  pgrep -x openfortivpn >/dev/null 2>&1
}

strip_quotes() {
  local s=$1
  s=${s%\"}; s=${s#\"}
  s=${s%\'}; s=${s#\'}
  printf '%s' "$s"
}

# openfortivpn's own DNS registration (via macOS SCDynamicStore) can fail
# silently on some macOS versions ("publish_entry SCDSet() failed" in the
# log), leaving the VPN's nameserver/search domains unset system-wide even
# though the tunnel itself is up. Work around it by parsing what the
# gateway actually handed us out of the log and writing /etc/resolver/<domain>
# files ourselves — same mechanism, done by hand.
#
# RESOLVER_MANIFEST is the source of truth for what we created, so cleanup
# is exact (never guesses at domain names) and idempotent.
apply_split_dns() {
  local ns_line nameservers domains
  ns_line=$(grep -m1 "Got addresses" "$LOG_FILE" 2>/dev/null || true)
  if [[ -z "$ns_line" ]]; then
    note "Could not find VPN-assigned DNS info in the log; leaving system DNS untouched."
    return 0
  fi

  nameservers=$(printf '%s' "$ns_line" | sed -E 's/.*ns \[([^]]*)\].*/\1/')
  domains=$(printf '%s' "$ns_line" | sed -E 's/.*ns_suffix \[([^]]*)\].*/\1/')

  local ns valid_ns=()
  IFS=', ' read -ra ns_split <<< "$nameservers"
  for ns in "${ns_split[@]}"; do
    [[ -n "$ns" && "$ns" != "0.0.0.0" ]] && valid_ns+=("$ns")
  done
  if (( ${#valid_ns[@]} == 0 )); then
    note "No usable VPN nameserver in the log; leaving system DNS untouched."
    return 0
  fi

  local d domain_list=()
  IFS=';' read -ra domain_split <<< "$domains"
  for d in "${domain_split[@]}"; do
    [[ -n "$d" ]] && domain_list+=("$d")
  done
  (( ${#domain_list[@]} > 0 )) || return 0

  sudo mkdir -p "$RESOLVER_DIR"
  local content=""
  for ns in "${valid_ns[@]}"; do content+="nameserver $ns"$'\n'; done
  for d in "${domain_list[@]}"; do
    printf '%s' "$content" | sudo tee "$RESOLVER_DIR/$d" >/dev/null
  done
  printf '%s\n' "${domain_list[@]}" | sudo tee "$RESOLVER_MANIFEST" >/dev/null

  sudo dscacheutil -flushcache
  sudo killall -HUP mDNSResponder >/dev/null 2>&1 || true
  note "Configured split-DNS resolvers for: ${domain_list[*]}"
}

remove_split_dns() {
  [[ -f "$RESOLVER_MANIFEST" ]] || return 0
  local d
  while IFS= read -r d; do
    [[ -n "$d" ]] && sudo rm -f "$RESOLVER_DIR/$d"
  done < <(sudo cat "$RESOLVER_MANIFEST" 2>/dev/null || true)
  sudo rm -f "$RESOLVER_MANIFEST"
  sudo dscacheutil -flushcache
  sudo killall -HUP mDNSResponder >/dev/null 2>&1 || true
}

# Self-healing: if the tunnel isn't actually up but resolver files are still
# sitting there (crash, kill -9, lid-close without a clean disconnect), a
# public domain could be left pointed at an unreachable internal IP
# indefinitely. Anything that reports/relies on connection state calls this
# first so leftovers never survive a single `ovn status`.
reconcile_split_dns() {
  if ! is_connected && [[ -f "$RESOLVER_MANIFEST" ]]; then
    note "Found stale split-DNS entries with no tunnel running; cleaning up."
    remove_split_dns
  fi
}

setup() {
  require_op
  echo "No config found at ${bold}$CONFIG_FILE${reset} — first-time setup."
  echo

  local host port username opref
  read -rp "VPN hostname: " host
  [[ -n "$host" ]] || die "A hostname is required."

  read -rp "Port [443]: " port
  port=${port:-443}

  read -rp "Username: " username
  [[ -n "$username" ]] || die "A username is required."

  echo
  echo "1Password secret reference for the VPN password (e.g. op://Vault/Item/password)."
  echo "In the 1Password app: right-click the item -> Copy Secret Reference."
  read -rp "1Password reference: " opref
  opref=$(strip_quotes "$opref")
  [[ -n "$opref" ]] || die "A 1Password reference is required."

  note "Verifying the reference resolves via op..."
  op read "$opref" >/dev/null 2>&1 || die "Could not read '$opref' via op. Check it and that you're signed in."

  sudo mkdir -p "$CONFIG_DIR"
  sudo tee "$CONFIG_FILE" >/dev/null <<EOF
host = $host
port = $port
username = $username
EOF
  sudo chmod 600 "$CONFIG_FILE"

  printf '%s\n' "$opref" | sudo tee "$OP_REF_FILE" >/dev/null
  sudo chmod 600 "$OP_REF_FILE"

  echo "Saved $CONFIG_FILE and $OP_REF_FILE."
}

cmd_status() {
  reconcile_split_dns
  if is_connected; then
    echo "${green}Connected${reset} (pid $(pgrep -x openfortivpn | tr '\n' ' ' | sed 's/ $//'))"
  else
    echo "${dim}Disconnected${reset}"
  fi
}

cmd_connect() {
  require_openfortivpn

  if is_connected; then
    note "Already connected."
    return 0
  fi

  reconcile_split_dns

  [[ -f "$CONFIG_FILE" ]] || setup
  require_op

  sudo -v || die "sudo authentication failed."

  [[ -f "$OP_REF_FILE" ]] || die "$OP_REF_FILE is missing. Remove $CONFIG_FILE and rerun 'ovn connect' to redo setup."
  local opref pass
  opref=$(strip_quotes "$(sudo cat "$OP_REF_FILE")")
  pass=$(op read "$opref") || die "Failed to read password from 1Password ($opref)."

  : > "$LOG_FILE"
  echo "Connecting..."
  sudo openfortivpn -c "$CONFIG_FILE" -p "$pass" >"$LOG_FILE" 2>&1 &
  disown 2>/dev/null || true
  unset pass

  echo "Waiting for the tunnel (approve the FortiToken push on your phone if prompted)..."
  local waited=0
  while (( waited < 60 )); do
    if grep -q "Tunnel is up and running" "$LOG_FILE" 2>/dev/null; then
      apply_split_dns
      echo "${green}Connected.${reset}"
      return 0
    fi
    if (( waited > 2 )) && ! is_connected; then
      die "openfortivpn exited before the tunnel came up. See $LOG_FILE"
    fi
    sleep 1
    ((waited++))
  done
  die "Timed out waiting for the tunnel to come up. See $LOG_FILE"
}

cmd_disconnect() {
  if ! is_connected; then
    reconcile_split_dns
    note "Already disconnected."
    return 0
  fi

  sudo pkill -x openfortivpn

  local waited=0
  while is_connected && (( waited < 15 )); do
    sleep 1
    ((waited++))
  done

  if is_connected; then
    die "Failed to stop openfortivpn."
  fi
  remove_split_dns
  echo "${dim}Disconnected.${reset}"
}

case "${1:-}" in
  status)     cmd_status ;;
  connect)    cmd_connect ;;
  disconnect) cmd_disconnect ;;
  -h|--help|"") usage ;;
  *) usage; die "Unknown command: $1" ;;
esac
